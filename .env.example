# ==============================================================================
# RADMAN SILVER 925 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# STATUS: DEPLOYMENT TOOLKIT PREPARED — NOT EXECUTED ON HOST
# INSTRUCTIONS: Copy this file to an account-private path outside the web root
# (e.g., /home/[CPANEL_USER]/.config/radman/staging.env) and populate with genuine
# credentials after host access is granted.
# SECURITY WARNING: NEVER commit .env to GitHub, store in web root, or share in logs.
# ==============================================================================

# --- 1. WORDPRESS DATABASE CREDENTIALS (MUST BE STORED OUTSIDE WEB ROOT) ---
DB_NAME=[TO_BE_PROVIDED_DB_NAME]
DB_USER=[TO_BE_PROVIDED_DB_USER]
DB_PASSWORD=[TO_BE_PROVIDED_DB_PASSWORD]
DB_HOST=[TO_BE_PROVIDED_DB_HOST]

# --- 2. WORDPRESS & WOOCOMMERCE REST API CREDENTIALS ---
WP_SITE_URL=[TO_BE_PROVIDED_WP_SITE_URL]
WC_CONSUMER_KEY=[TO_BE_PROVIDED_WC_CONSUMER_KEY]
WC_CONSUMER_SECRET=[TO_BE_PROVIDED_WC_CONSUMER_SECRET]

# --- 3. LEGACY STORE API (noghrehmashhad.ir SOURCE OF TRUTH) ---
LEGACY_API_BASE_URL=https://noghrehmashhad.ir
LEGACY_API_KEY=[TO_BE_PROVIDED_LEGACY_API_KEY]
LEGACY_API_SECRET=[TO_BE_PROVIDED_LEGACY_API_SECRET]

# --- 4. TELEGRAM MANAGEMENT BOT (HITL APPROVAL GATEWAY) ---
TELEGRAM_BOT_TOKEN=[TO_BE_PROVIDED_TELEGRAM_BOT_TOKEN]
TELEGRAM_OWNER_CHAT_ID=[TO_BE_PROVIDED_TELEGRAM_OWNER_CHAT_ID]
TELEGRAM_ADMIN_IDS=[TO_BE_PROVIDED_ADMIN_ID_1],[TO_BE_PROVIDED_ADMIN_ID_2]

# --- 5. ZARINPAL PAYMENT GATEWAY (IRANIAN SHETAB DEBIT CARD GATEWAY) ---
ZARINPAL_MERCHANT_ID=[TO_BE_PROVIDED_ZARINPAL_MERCHANT_ID]
ZARINPAL_SANDBOX_MODE=true

# --- 6. KAVENEGAR SMS GATEWAY (OTP & ORDER TRANSACTIONAL ALERTS) ---
KAVENEGAR_API_KEY=[TO_BE_PROVIDED_KAVENEGAR_API_KEY]
KAVENEGAR_SENDER_NUMBER=[TO_BE_PROVIDED_SENDER_NUMBER]

# --- 7. PRICING RULES & ROUNDING DEFAULTS ---
SILVER_DEFAULT_DAILY_RATE_TOMAN=[TO_BE_PROVIDED_DAILY_RATE_BY_OWNER]
DEFAULT_ROUNDING_STEP_TOMAN=10000

# --- 8. APPLICATION & STAGING SETTINGS ---
APP_ENV=staging
LOG_LEVEL=INFO
STAGING_DB_PATH=./legacy_sync_map.db
