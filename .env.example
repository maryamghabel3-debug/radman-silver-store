# ==============================================================================
# RADMAN SILVER STORE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and populate with genuine production credentials.
# SECURITY WARNING: NEVER commit .env to GitHub or share in public chat logs.
# ==============================================================================

# --- 1. WORDPRESS & WOOCOMMERCE REST API CREDENTIALS ---
WP_SITE_URL=https://radmansilver.ir
WC_CONSUMER_KEY=ck_your_woocommerce_consumer_key_here
WC_CONSUMER_SECRET=cs_your_woocommerce_consumer_secret_here

# --- 2. LEGACY STORE API (noghrehmashhad.ir SOURCE OF TRUTH) ---
LEGACY_STORE_URL=https://noghrehmashhad.ir
LEGACY_WC_CONSUMER_KEY=ck_legacy_store_key_here
LEGACY_WC_CONSUMER_SECRET=cs_legacy_store_secret_here

# --- 3. TELEGRAM MANAGEMENT BOT (HITL APPROVAL GATEWAY) ---
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_example_token
# Comma-separated list of authorized owner/admin Telegram User IDs
TELEGRAM_ADMIN_IDS=100000001,100000002

# --- 4. ZARINPAL PAYMENT GATEWAY (IRANIAN SHETAB DEBIT CARD GATEWAY) ---
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX_MODE=false

# --- 5. KAVENEGAR SMS GATEWAY (OTP & ORDER TRANSACTIONAL ALERTS) ---
KAVENEGAR_API_KEY=your_kavenegar_api_key_here
KAVENEGAR_SENDER_NUMBER=1000xxxxxx

# --- 6. TEHRAN GOLD & SILVER MARKET API (DAILY 925 GRAM RATE FEED) ---
SILVER_MARKET_API_URL=https://api.example-iran-gold.ir/v1/rates/silver925
SILVER_MARKET_API_KEY=your_market_api_key_here

# --- 7. DATABASE & ENVIRONMENT SETTINGS ---
APP_ENV=production
LOG_LEVEL=INFO
STAGING_DB_PATH=./legacy_sync_map.db
