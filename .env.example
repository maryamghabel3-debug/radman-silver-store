# ==============================================================================
# RADMAN SILVER 925 — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# STATUS: DEPLOYMENT TOOLKIT PREPARED — NOT EXECUTED ON HOST
# INSTRUCTIONS: Copy this file to an account-private path outside the web root
# (e.g., /home/[CPANEL_USER]/.config/radman/staging.env) and populate with genuine
# credentials after host access is granted.
# SECURITY WARNING: NEVER commit .env to GitHub, store in web root, or share in logs.
# ==============================================================================

# --- 1. WORDPRESS DATABASE CREDENTIALS (MUST BE STORED OUTSIDE WEB ROOT) ---
DB_NAME=[CPANEL_PREFIXED_DB_NAME]
DB_USER=[CPANEL_PREFIXED_DB_USER]
DB_PASSWORD=[SET_ONLY_IN_PRIVATE_SERVER_ENV]
DB_HOST=localhost

# --- 2. WORDPRESS ADMINISTRATOR CREDENTIALS ---
ADMIN_USER=[TBD]
ADMIN_EMAIL=[TBD]

# --- 3. WORDPRESS & WOOCOMMERCE REST API CREDENTIALS ---
WP_SITE_URL=[TO_BE_PROVIDED_WP_SITE_URL]
WC_CONSUMER_KEY=[TO_BE_PROVIDED_WC_CONSUMER_KEY]
WC_CONSUMER_SECRET=[TO_BE_PROVIDED_WC_CONSUMER_SECRET]

# --- 4. LEGACY STORE API (noghrehmashhad.ir SOURCE OF TRUTH) ---
LEGACY_API_BASE_URL=https://noghrehmashhad.ir
LEGACY_API_KEY=[TO_BE_PROVIDED_LEGACY_API_KEY]
LEGACY_API_SECRET=[TO_BE_PROVIDED_LEGACY_API_SECRET]

# --- 5. TELEGRAM MANAGEMENT BOT (HITL APPROVAL GATEWAY) ---
TELEGRAM_BOT_TOKEN=[TBD_OPTIONAL]
TELEGRAM_OWNER_CHAT_ID=[TBD_OPTIONAL]
TELEGRAM_ADMIN_IDS=[TBD_COMMA_SEPARATED]

# --- 6. ZARINPAL PAYMENT GATEWAY (IRANIAN SHETAB DEBIT CARD GATEWAY) ---
ZARINPAL_MERCHANT_ID=[TBD]
ZARINPAL_SANDBOX_MODE=true

# --- 7. KAVENEGAR SMS GATEWAY (OTP & ORDER TRANSACTIONAL ALERTS) ---
KAVENEGAR_API_KEY=[TBD]
KAVENEGAR_SENDER_NUMBER=[TBD]

# --- 8. PRICING RULES & ROUNDING DEFAULTS ---
SILVER_DEFAULT_DAILY_RATE_TOMAN=[OWNER_INPUT_REQUIRED]
DEFAULT_ROUNDING_STEP_TOMAN=10000

# --- 9. APPLICATION & STAGING SETTINGS ---
APP_ENV=staging
LOG_LEVEL=INFO
RADMAN_ENV_FILE=[ABSOLUTE_PRIVATE_PATH_OUTSIDE_WEB_ROOT]
SYNC_STATE_PATH=[ABSOLUTE_PRIVATE_STATE_PATH_OUTSIDE_WEB_ROOT]
