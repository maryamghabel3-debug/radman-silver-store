# ==============================================================================
# تنظیمات اتصال به مدل AvalAI برای پلتفرم ایجنتی رادمان سیلور ۹۲۵
# AvalAI Model Connection Configuration for RADMAN SILVER 925
# ------------------------------------------------------------------------------
# راهنمای استفاده:
# ۱. این فایل را به نام ai.env کپی کنید:  cp tools/ai.env.example ai.env
# ۲. کلید دریافتی از پنل AvalAI را در متغیر AVALAI_API_KEY قرار دهید.
# ۳. پرمیشن فایل را برای امنیت بیشتر محدود کنید: chmod 600 ai.env
# ==============================================================================

# کلید اختصاصی API دریافتی از پنل AvalAI (هرگز در گیت کامیت نکنید)
AVALAI_API_KEY=your_avalai_api_key_here

# آدرس پایه سرویس AvalAI (سازگار با پروتکل OpenAI)
# مسیر عمومی: https://api.avalai.ir/v1
# مسیر سرور داخلی/ایران: https://api.avalapis.ir/v1
AVALAI_BASE_URL=https://api.avalai.ir/v1

# مدل پیش‌فرض مورد استفاده برای تست و تحلیل (قابل تغییر توسط مالک)
# گزینه‌های پیشنهادی: gpt-4o-mini, gpt-4o, claude-3-5-haiku
AVALAI_MODEL=gpt-4o-mini

# سقف زمان انتظار برای پاسخ (ثانیه)
AVALAI_TIMEOUT_SECONDS=30

# حداکثر تعداد تلاش مجدد در صورت خطای شبکه
AVALAI_MAX_RETRIES=2
